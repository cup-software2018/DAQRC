#
# DAQ Server where tcb is supposed to be running
#
kDAQSERVER_IP = 'localhost'  # Update with actual DAQ IP
kDAQSERVER_PORT = 7100       # Update with actual DAQ Port
kDAQSERVER_ADDR = 'tcp://%s:%d' % (kDAQSERVER_IP, kDAQSERVER_PORT)

# If RC is running on same server with DAQ
kISREMOTEDAQ = False

# Directories at DAQ server
kONLDAQ_DIR = '/opt/cupdaq'  # Set to actual directory
kRAWDATA_DIR = '/data'       # Set to actual directory

# Run catalog db file should be in same server with RC
kRUNCATALOGDBFILE = 'runcatalog.db'
kDEFAULTCONFIGDIR = './config'

# Add more run types
kRUNTYPELIST = ['', 'physics', 'calibration', 'test']

kOUTPUTFILEFORMAT = 'hdf5' # hdf5 or root
kOUTPUTSPLITTIME = 3600 # 1 hour for spliting output file


# ===========================================================
# Do not modify from here!!!
# ===========================================================

kSTATSREPORTINTERVAL = 10 # for influxdb

# DAQ Monitor Server (daqmon_server.py) settings
kDAQMON_LOG_FILE         = '/tmp/cupdaq_daqmon_server.log'
kDAQMON_PID_FILE         = '/tmp/cupdaq_daqmon_server.pid'
kDAQMON_IDLE_TIMEOUT     = 3600  # seconds before entering degraded mode when DAQ is DOWN
kDAQMON_RECONNECT_INTERVAL = 10  # seconds between DAQ reconnection attempts

# DAQ Monitor ZMQ Server Address
kDAQMON_IP       = 'localhost'
kDAQMON_CMD_PORT = 7030
kDAQMON_CMD_ADDR = 'tcp://%s:%d' % (kDAQMON_IP, kDAQMON_CMD_PORT)
kDAQMON_PUB_PORT = 7031
kDAQMON_PUB_ADDR = 'tcp://%s:%d' % (kDAQMON_IP, kDAQMON_PUB_PORT)

kEXESCRIPT = 'executedaq.sh'

# Commands (Updated for JSON payload)
kCONFIGRUN = "kCONFIGRUN"
kSTARTRUN = "kSTARTRUN"
kENDRUN = "kENDRUN"
kEXIT = "kEXIT"
kQUERYDAQSTATUS = "kQUERYDAQSTATUS"
kQUERYRUNINFO = "kQUERYRUNINFO"
kQUERYTRGINFO = "kQUERYTRGINFO"
kQUERYMONITOR = "kQUERYMONITOR"

# RUN Status
kDOWN = 0
kBOOTED = 1
kCONFIGURED = 2
kRUNNING = 3
kRUNENDING = 4
kRUNENDED = 5
kPROCENDED = 6
kWARNING = 7
kERROR = 8

kDAQSTATE = ['Down', 'Booted', 'Configured',
             'Running', 'RunEnding', 'RunEnded', 'ProcEnded', 'Warning', 'Error']